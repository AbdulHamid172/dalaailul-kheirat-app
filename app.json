{
  "expo": {
    "name": "Dalaailul Khairat",
    "slug": "dalaailul-kheirat",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "dalaailul",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abdulhamid.dalaailul",
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "com.abdulhamid.dalaailul",
      "adaptiveIcon": {
        "backgroundColor": "#f9f6ef",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b480c595-c991-4420-8be5-3f1dc02b0a7d"
      }
    },
    "owner": "jabbarhamid"
  }
}
